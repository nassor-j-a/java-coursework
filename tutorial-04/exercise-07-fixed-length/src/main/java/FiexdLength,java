import java.util.Scanner;

/**
 * Exercise 4-7
 * Fixed Length
 *
 * Prints two strings separated by dots
 * so that the total output length is 30 characters.
 */
public class FixedLength {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        System.out.println("==================================");
        System.out.println("          Fixed Length");
        System.out.println("==================================");

        System.out.print("Enter first word: ");
        String firstWord = scanner.nextLine();

        System.out.print("Enter second word: ");
        String secondWord = scanner.nextLine();

        final int TOTAL_LENGTH = 30;

        int numberOfDots = TOTAL_LENGTH - firstWord.length() - secondWord.length();

        System.out.print(firstWord);

        for (int i = 0; i < numberOfDots; i++) {
            System.out.print(".");
        }

        System.out.println(secondWord);

        scanner.close();
    }
}